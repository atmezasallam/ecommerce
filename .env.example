# =============================================================================
# Copy to `.env` or `.env.local` and fill in real values. Never commit secrets.
# =============================================================================

# --- Database (Prisma) ---
# MySQL connection string used by prisma/schema.prisma and prisma/prisma.config.ts.
# Local: create a DB, then set USER/PASSWORD/host/db name.
# Hosted: Railway, PlanetScale, Aiven, or any MySQL provider → connection URI.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ecommerce"

# --- Clerk authentication (@clerk/nextjs) ---
# Dashboard: https://dashboard.clerk.com → your application → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret for POST /api/webhooks (user.created, etc.).
# Dashboard → Webhooks → endpoint signing secret (Svix).
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional Clerk route URLs (read automatically by @clerk/nextjs; not referenced
# via process.env in app code). Match your App Router auth pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Stripe payments ---
# Dashboard: https://dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for POST /api/webhooks/stripe.
# Dashboard → Developers → Webhooks → signing secret (whsec_…).
# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary image uploads ---
# Dashboard: https://cloudinary.com/console → Cloud name + Upload presets
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Unsigned upload preset name (Media Library → Upload → Upload presets)
NEXT_PUBLIC_CLOUDINARY_PRESET_NAME=

# --- Optional: IP geolocation ---
# Used in src/lib/utils.ts for country detection (shipping defaults).
# Obtain a token at https://ipinfo.io/ (free tier available).
IPINFO_TOKEN=

# --- Optional: platform admins ---
# Comma-separated emails promoted to ADMIN on Clerk user.created
# (src/app/api/webhooks/route.ts). Example: you@example.com,ops@example.com
ADMIN_EMAILS=
